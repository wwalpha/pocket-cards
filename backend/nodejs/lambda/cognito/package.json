    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.0",
    "dotenv": "^10.0.0",
    "jest": "^29.7.0",
    "typescript": "7.0.2",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39"
  },
  "engines": {
    "node": "24.x"
  }
