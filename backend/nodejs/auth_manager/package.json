{
  "name": "auth-manager",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon ./src/index.ts dotenv_config_path=.env.dev",
    "build": "tsc -p tsconfig.build.json",
    "build:image": "yarn build && docker build -t pkc/auth_manager .",
    "start": "node index.js",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@aws-sdk/types": "^3.272.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^8.5.2",
    "@types/lodash": "^4.14.170",
    "@types/morgan": "^1.9.3",
    "@types/node": "^24.13.0",
    "@types/supertest": "^2.0.11",
    "dotenv": "^16.0.0",
    "jest": "^29.7.0",
    "nodemon": "^2.0.7",
    "superagent": "^7.1.2",
    "supertest": "^6.1.3",
    "tsc-alias": "^1.9.4",
    "typescript": "7.0.2",
    "tsx": "^4.23.13",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39"
  },
  "dependencies": {
    "@alphax/dynamodb": "^1.2.13",
    "@aws-sdk/client-cognito-identity-provider": "^3.279.0",
    "amazon-cognito-identity-js": "^5.2.8",
    "axios": "^0.26.1",
    "body-parser": "^1.19.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.21",
    "morgan": "^1.10.0",
    "winston": "^3.6.0"
  },
  "nodemonConfig": {
    "watch": [
      "src/**/*.ts"
    ],
    "delay": 3,
    "ignore": [
      "node_modules/*"
    ],
    "execMap": {
      "ts": "tsx --tsconfig ./tsconfig.json -r dotenv/config"
    },
    "events": {
      "crash": "sh -c 'lsof -i :${PORT:-8080} -t | xargs kill'"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
