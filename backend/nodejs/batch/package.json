{
  "name": "batch",
  "version": "1.0.1",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "debug": "tsx --tsconfig ./tsconfig.json -r dotenv/config src/index.ts",
    "test": "jest",
    "test:local": "jest test/services/learningStatus.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@aws-sdk/types": "^3.272.0",
    "@types/express": "^4.17.14",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.14.180",
    "@types/node": "^24.13.0",
    "csv-parse": "^5.3.1",
    "dotenv": "^16.0.0",
    "express": "^4.21.2",
    "jest": "^29.2.2",
    "jest-extended": "^3.1.0",
    "nodemon": "^2.0.15",
    "tsc-alias": "^1.9.4",
    "typescript": "7.0.2",
    "tsx": "^4.23.13",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39"
  },
  "dependencies": {
    "@alphax/dynamodb": "^1.2.16",
    "@aws-sdk/client-athena": "^3.279.0",
    "@aws-sdk/client-s3": "^3.279.0",
    "@aws-sdk/client-ses": "^3.279.0",
    "@aws-sdk/client-ssm": "^3.279.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.1"
  },
  "nodemonConfig": {
    "watch": [
      "src/**/*.ts"
    ],
    "delay": 3,
    "ignore": [
      "node_modules/*"
    ],
    "execMap": {
      "ts": "tsx --tsconfig ./tsconfig.json -r dotenv/config"
    },
    "events": {
      "crash": "sh -c 'lsof -i :${PORT:-8080} -t | xargs kill'"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
